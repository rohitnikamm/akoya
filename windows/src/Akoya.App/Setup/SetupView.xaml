<!--
  The setup card (docs/design/windows-onboarding-mockup.html .card): 380×520, radius 44, blue rim glow, the grid over
  the lower 55%, the step, the page dots with Skip, and the ✕. DataContext: SetupViewModel. The card's drop shadow
  paints outside these bounds; the window leaves room for it.
-->
<UserControl x:Class="Akoya.App.Setup.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Akoya.App.Controls"
             xmlns:setup="clr-namespace:Akoya.App.Setup"
             xmlns:ui="clr-namespace:Akoya.Core.Ui;assembly=Akoya.Core"
             Width="380" Height="520"
             FontFamily="{DynamicResource Akoya.FontFamily}"
             Foreground="{DynamicResource Akoya.TextPrimary}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Akoya.App;component/Setup/SetupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:RimGlowBorder CornerRadius="44"
                            Background="{DynamicResource Setup.CardBackground}"
                            Shadows="{x:Static setup:SetupGlows.Card}">
        <Grid>
            <!-- Try it: the Mac's voice glow over the fixed one, rising with the voice (0 at rest and on other steps). -->
            <controls:RimGlowBorder x:Name="VoiceGlow" CornerRadius="44" IsHitTestVisible="False"
                                    Shadows="{x:Static ui:RimGlowRecipes.SetupCardListening}"
                                    GlowStrength="{Binding GlowStrength}" />
            <controls:ClipBorder CornerRadius="44" IsHitTestVisible="False">
                <Grid>
                    <Rectangle Height="286" VerticalAlignment="Bottom"
                               Fill="{DynamicResource Setup.GridLines}"
                               OpacityMask="{DynamicResource Setup.GridMask}" />
                    <!-- The grid brightens with the voice, as on the Mac (up to twice its rest strength). -->
                    <Rectangle x:Name="GridBoost" Height="286" VerticalAlignment="Bottom"
                               Fill="{DynamicResource Setup.GridLines}"
                               OpacityMask="{DynamicResource Setup.GridMask}"
                               Opacity="{Binding GlowStrength}" />
                </Grid>
            </controls:ClipBorder>

            <!-- .in: padding 34 30 22; the step above, the 14-tall footer below. -->
            <Grid Margin="30,34,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                </Grid.RowDefinitions>

                <setup:WelcomeView x:Name="WelcomeStep" />
                <setup:MicrophoneView x:Name="MicrophoneStep" />
                <setup:TryItView x:Name="TryItStep" />

                <StackPanel x:Name="PageDots" Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="SkipButton" Grid.Row="1"
                        Style="{DynamicResource Setup.Bare}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-1,4,-3"
                        Command="{Binding SkipCommand}">
                    <TextBlock Text="Skip" FontSize="13" LineStackingStrategy="BlockLineHeight" LineHeight="16"
                               Foreground="{DynamicResource Akoya.TextEyebrow}" />
                </Button>
            </Grid>

            <!-- .x: 30×30 at 20 from the top right. -->
            <Button x:Name="CloseButton"
                    Style="{DynamicResource Setup.Bare}"
                    Width="30" Height="30" Margin="0,20,20,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent"
                    ToolTip="Close"
                    Command="{Binding SkipCommand}">
                <Grid>
                    <Ellipse Fill="{DynamicResource Setup.CloseFill}" />
                    <Path Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M0,0 L8,8 M8,0 L0,8"
                          Stroke="{DynamicResource Setup.CloseGlyph}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Button>
        </Grid>
    </controls:RimGlowBorder>
</UserControl>
