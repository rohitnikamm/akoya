<!-- Step 1 (mockup [data-welcome]): the dot logo, "Akoya", the one-line pitch, Get started. Items 14 apart. -->
<UserControl x:Class="Akoya.App.Setup.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Akoya.App.Controls"
             xmlns:setup="clr-namespace:Akoya.App.Setup">
    <DockPanel Margin="0,0,0,14">
        <Button DockPanel.Dock="Bottom" Style="{DynamicResource Setup.ButtonLight}"
                Content="Get started" Command="{Binding GetStartedCommand}" />
        <StackPanel>
            <!-- .logo: columns of 2-4-6-4-2 dots, 10 across, 11 between columns, 6 between rows; 96 tall. -->
            <Grid Height="96" Margin="0,30,0,0">
                <controls:DotGrid Columns="5" Rows="6" DotSize="10" Gap="6" ColumnGap="11"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  DefaultOpacity="0"
                                  Opacities="{x:Static setup:WelcomeView.LogoDots}"
                                  Halo="{x:Static setup:SetupGlows.LogoDot}"
                                  DotBrush="{DynamicResource Akoya.TextPrimary}" />
            </Grid>
            <TextBlock Margin="0,24,0,0" Style="{DynamicResource Setup.Title}"
                       FontSize="32" LineHeight="40" Text="Akoya" />
            <TextBlock Margin="0,8,0,0" Style="{DynamicResource Setup.Body}"
                       FontSize="15" LineHeight="21.75">Talk instead of type, in any app.<LineBreak />Everything stays on your PC.</TextBlock>
        </StackPanel>
    </DockPanel>
</UserControl>
