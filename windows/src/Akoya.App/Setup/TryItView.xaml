<!--
  Step 3 (mockup card "Try it"): the hotkey hint, the live waveform, the text card filling in live (practice
  destination, nothing is pasted), Done. Items 14 apart.
-->
<UserControl x:Class="Akoya.App.Setup.TryItView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Akoya.App.Controls"
             xmlns:setup="clr-namespace:Akoya.App.Setup">
    <DockPanel Margin="0,0,0,14">
        <Button x:Name="DoneButton" DockPanel.Dock="Bottom" Style="{DynamicResource Setup.ButtonQuiet}"
                Content="Done" Command="{Binding DoneCommand}" />
        <StackPanel>
            <controls:TrackedText Margin="0,10,0,0" Style="{DynamicResource Setup.Eyebrow}" Text="TRY IT" />

            <StackPanel x:Name="Hint">
                <!-- .hint: "Hold [Right Alt] and say anything", 15px, items 7 apart. -->
                <StackPanel Margin="0,20,0,0" Height="25" Orientation="Horizontal" HorizontalAlignment="Center"
                            TextElement.FontSize="15" TextElement.Foreground="{DynamicResource Setup.Hint}">
                    <TextBlock VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="19" Text="Hold" />
                    <Border Margin="7,0" Padding="10,2" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource Setup.KeycapFill}" BorderBrush="{DynamicResource Setup.KeycapBorder}">
                        <TextBlock FontWeight="SemiBold" LineStackingStrategy="BlockLineHeight" LineHeight="19"
                                   Foreground="{DynamicResource Akoya.TextPrimary}" Text="{Binding HotkeyLabel}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="19" Text="and say anything" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="13" LineStackingStrategy="BlockLineHeight" LineHeight="16"
                           Foreground="{DynamicResource Setup.HintSecondary}"
                           Text="or tap it once to start, again to stop" />
            </StackPanel>

            <!-- .wave: 66 tall; 23 columns of 5px dots, 4 apart, rows 3 apart (9 dots overhang it a little). -->
            <Grid Height="66" Margin="0,14,0,0">
                <controls:DotGrid Columns="23" Rows="9" DotSize="5" Gap="3" ColumnGap="4"
                                  Margin="0,-1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  DefaultOpacity="0"
                                  Opacities="{Binding WaveOpacities}"
                                  Halo="{x:Static setup:SetupGlows.WaveDot}"
                                  DotBrush="{DynamicResource Setup.WaveDot}" />
            </Grid>

            <!-- Model status under the dots, which fill with the download: "Getting the speech model ready 62%", or
                 "Model download failed · Retry". Gone once the model is ready. -->
            <StackPanel x:Name="ModelStatus" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center"
                        TextElement.FontSize="13">
                <TextBlock x:Name="ModelStatusText" VerticalAlignment="Center" Text="{Binding ModelStatusText}" />
                <TextBlock x:Name="ModelStatusPercent" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Medium"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource Akoya.TextPrimary}" Text="{Binding ModelStatusPercent}" />
                <TextBlock x:Name="RetrySeparator" Margin="6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Setup.ModelStatusError}" Text="·" />
                <Button x:Name="RetryButton" VerticalAlignment="Center"
                        Style="{DynamicResource Setup.Bare}" Command="{Binding RetryModelCommand}">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Akoya.AccentLightSoft}"
                               Text="Retry" />
                </Button>
            </StackPanel>

            <!-- .txt: min 86 tall, padding 13 15, rounded 20, 15.5px at 1.45; newest words stay in view. -->
            <Border Margin="0,14,0,0" MinHeight="86" CornerRadius="20" Padding="15,13"
                    Background="{DynamicResource Setup.TextCard}">
                <ScrollViewer x:Name="CardScroll" MaxHeight="129" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <TextBlock x:Name="CardText" TextWrapping="Wrap"
                               FontSize="15.5" LineStackingStrategy="BlockLineHeight" LineHeight="22.475"
                               Text="{Binding CardText}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
