<!--
  The tray panel's content (spec "Tray icon and panel"; docs/design/all-in-one-dropdown-target.html without the
  "Menu bar icon" row, the yellow row of windows-onboarding-mockup.html): status card, last dictation, options, Quit.
  300 wide, height to content. DataContext: TrayPanelViewModel. The hotkey and microphone menus are drawn inside the
  panel (MenuLayer), not as popups, so they never take focus or leave the window. Outer shadows paint outside these
  bounds; TrayPanelWindow leaves room for them.
-->
<UserControl x:Class="Akoya.App.Tray.TrayPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Akoya.App.Controls"
             xmlns:tray="clr-namespace:Akoya.App.Tray"
             xmlns:ui="clr-namespace:Akoya.Core.Ui;assembly=Akoya.Core"
             Width="{x:Static tray:TrayPanelView.PanelWidth}"
             FontFamily="{DynamicResource Akoya.FontFamily}"
             FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- Colours of the mockup that aren't theme-wide (white at the mockup's opacities). -->
        <SolidColorBrush x:Key="Tray.TextRow" Color="#E0FFFFFF" />           <!-- .88 rows -->
        <SolidColorBrush x:Key="Tray.TextValue" Color="#9EFFFFFF" />         <!-- .62 values, labels, Quit -->
        <SolidColorBrush x:Key="Tray.TextHint" Color="#C7FFFFFF" />          <!-- .78 hint, chip -->
        <SolidColorBrush x:Key="Tray.TextHintSecondary" Color="#8CFFFFFF" /> <!-- .55 second hint line, menu title -->
        <SolidColorBrush x:Key="Tray.Icon" Color="#99FFFFFF" />              <!-- .60 row icons, drop marks -->
        <SolidColorBrush x:Key="Tray.Hairline" Color="#12FFFFFF" />          <!-- .07 separators -->
        <SolidColorBrush x:Key="Tray.InnerFlat" Color="#8C1E243A" />         <!-- rgba(30,36,58,.55) -->
        <SolidColorBrush x:Key="Tray.GlowBase" Color="#020611" />
        <SolidColorBrush x:Key="Tray.MenuBackground" Color="#161B2C" />
        <SolidColorBrush x:Key="Tray.Hover" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="Tray.Selected" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Tray.ProgressTrack" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Tray.WarnFill" Color="#1FFBBF24" />          <!-- rgba(251,191,36,.12) -->
        <SolidColorBrush x:Key="Tray.WarnRim" Color="#80FBBF24" />           <!-- rgba(251,191,36,.5) -->

        <!-- .panel: linear-gradient(180deg, #0E1424, #070A12) -->
        <LinearGradientBrush x:Key="Tray.PanelBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#0E1424" />
            <GradientStop Offset="1" Color="#070A12" />
        </LinearGradientBrush>

        <!--
          .card: radial-gradient(ellipse at 50% 0%, rgba(40,90,200,.22) 0, transparent 62%) as browsers draw it: a
          farthest-corner ellipse with radii √2 × the distances to that corner (the Mac's calibrated V1TopGradient).
        -->
        <RadialGradientBrush x:Key="Tray.CardTopGlow" Center="0.5,0" GradientOrigin="0.5,0"
                             RadiusX="0.70711" RadiusY="1.41421">
            <GradientStop Offset="0" Color="#382F5AC8" />
            <GradientStop Offset="0.62" Color="#002F5AC8" />
        </RadialGradientBrush>

        <!-- .grid: radial-gradient(rgba(255,255,255,.07) 1px, transparent 1.2px) on 10 px tiles. -->
        <DrawingBrush x:Key="Tray.CardDots" TileMode="Tile" Stretch="None"
                      Viewport="0,0,10,10" ViewportUnits="Absolute" Viewbox="0,0,10,10" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H10 V10 H0 Z" />
                    <GeometryDrawing Brush="#12FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="5,5" RadiusX="1.1" RadiusY="1.1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- The tiny ▾ after the keycap and the microphone name (the Mac's DropMark). -->
        <Style x:Key="Tray.DropMark" TargetType="Path">
            <Setter Property="Data" Value="M0,0 L4.6,0 L2.3,3.6 Z" />
            <Setter Property="Width" Value="4.6" />
            <Setter Property="Height" Value="3.6" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Fill" Value="{StaticResource Tray.Icon}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Row icons: 14×14, stroked 1.3 in white 60% (the mockup's SVGs). -->
        <Style x:Key="Tray.RowIcon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stroke" Value="{StaticResource Tray.Icon}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A full-width option row that is a button (Microphone, Quit): flat, a faint wash on hover. -->
        <Style x:Key="Tray.RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Tray.TextRow}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Tray.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Tray.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quit Akoya: a quiet text row, white 62%, brighter on hover. -->
        <Style x:Key="Tray.QuietRow" TargetType="Button" BasedOn="{StaticResource Tray.RowButton}">
            <Setter Property="Foreground" Value="{StaticResource Tray.TextValue}" />
            <Setter Property="Padding" Value="14,6,14,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Tray.TextRow}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Copy: a blue text link (12, #93C5FD). -->
        <Style x:Key="Tray.Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Akoya.AccentLight}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter x:Name="Text" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Call-to-action buttons (Retry, Open Settings, Restart): the accent gradient capsule, the Mac's PrimaryButton. -->
        <Style x:Key="Tray.PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" CornerRadius="999" Background="{DynamicResource Akoya.AccentGradient}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Ring" CornerRadius="999" Margin="-2" BorderThickness="1.5"
                                    BorderBrush="#99FFFFFF" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The hotkey keycap (.kc / .kc-open): white 8% with a white 16% border; brighter while its menu is open. -->
        <Style x:Key="Tray.Keycap" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#29FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" Padding="10,3,8,3"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHotkeyMenuOpen}" Value="True">
                    <Setter Property="Background" Value="#29FFFFFF" />
                    <Setter Property="BorderBrush" Value="#4DFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A menu row (.mi / .mi.sel): white 88%, radius 8, the selected row on white 10% with a ✓. -->
        <Style x:Key="Tray.MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Tray.TextRow}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" Padding="8,7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Tray.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Tray.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Tray.Selected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A menu row's content: the label, then a ✓ column (12 wide) checked on the selected row. -->
        <DataTemplate x:Key="Tray.MenuRowContent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Path Grid.Column="1" Width="10" Height="8" Stretch="Fill" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Data="M0,4 L3.4,7.4 L10,0.6" Stroke="White" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="{Binding IsSelected, Converter={StaticResource Visible}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" TextElement.Foreground="{StaticResource Tray.TextRow}">
        <controls:RimGlowBorder x:Name="Panel"
                                CornerRadius="30"
                                Padding="14"
                                Background="{StaticResource Tray.PanelBackground}"
                                Shadows="{x:Static ui:RimGlowRecipes.TrayPanel}">
            <StackPanel>
                <!-- 1. Status card -->
                <Grid x:Name="StatusCard">
                    <Border CornerRadius="24" Background="{DynamicResource Akoya.Surface}" />
                    <Border CornerRadius="24" Background="{StaticResource Tray.CardTopGlow}" />
                    <Border x:Name="GlowBase" CornerRadius="24" Background="{StaticResource Tray.GlowBase}"
                            Opacity="{Binding GlowBaseOpacity}" />
                    <controls:RimGlowBorder x:Name="CardGlow" CornerRadius="24"
                                            Shadows="{x:Static ui:RimGlowRecipes.TrayStatusCardListening}"
                                            GlowStrength="{Binding GlowStrength}" />
                    <Border CornerRadius="24" Background="{StaticResource Tray.CardDots}" />

                    <StackPanel Margin="16,16,16,14">
                        <Grid>
                            <TextBlock Text="Akoya" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center" />
                            <StackPanel x:Name="StatusChip" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding StatusInHeader, Converter={StaticResource Visible}}">
                                <controls:RimGlowBorder x:Name="StatusDot" Width="7" Height="7" CornerRadius="3.5"
                                                        VerticalAlignment="Center">
                                    <controls:RimGlowBorder.Style>
                                        <Style TargetType="controls:RimGlowBorder">
                                            <Setter Property="Background" Value="{DynamicResource Akoya.AccentLight}" />
                                            <Setter Property="Shadows" Value="{x:Static ui:RimGlowRecipes.StatusDotBlue}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource Akoya.Amber}" />
                                                    <Setter Property="Shadows" Value="{x:Static ui:RimGlowRecipes.StatusDotAmber}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource Akoya.Red}" />
                                                    <Setter Property="Shadows" Value="{x:Static ui:RimGlowRecipes.StatusDotRed}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:RimGlowBorder.Style>
                                </controls:RimGlowBorder>
                                <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Tray.TextHint}"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                                           Text="{Binding StatusText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Height="44" Margin="0,10,0,2">
                            <controls:DotLogo x:Name="Logo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Halo="{x:Static ui:RimGlowRecipes.LogoDot}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    TextElement.Foreground="{StaticResource Tray.TextHint}">
                            <TextBlock Text="Hold" VerticalAlignment="Center" />
                            <Button x:Name="Keycap" Style="{StaticResource Tray.Keycap}" Margin="7,0"
                                    Command="{Binding ToggleHotkeyMenu}"
                                    AutomationProperties.Name="Hotkey"
                                    AutomationProperties.HelpText="Choose the key to hold or tap">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding HotkeyLabel}" Foreground="White" />
                                    <Path Style="{StaticResource Tray.DropMark}" Margin="5,3,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="to talk" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource Tray.TextHintSecondary}"
                                   Text="or tap it once to start, again to stop" />

                        <!-- The status under the hint while the model loads, with its progress bar when known. -->
                        <StackPanel x:Name="StatusLine" Margin="0,10,0,0"
                                    Visibility="{Binding StatusUnderHint, Converter={StaticResource Visible}}">
                            <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Tray.TextHint}"
                                       Typography.NumeralAlignment="Tabular" Text="{Binding StatusText}" />
                            <Grid x:Name="ProgressBar" Width="180" Height="3" Margin="0,8,0,0" HorizontalAlignment="Center"
                                  Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}">
                                <Border CornerRadius="1.5" Background="{StaticResource Tray.ProgressTrack}" />
                                <Border x:Name="ProgressFill" CornerRadius="1.5" Background="{DynamicResource Akoya.AccentLight}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ProgressFraction}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Button x:Name="RetryButton" Style="{StaticResource Tray.PrimaryButton}" Margin="0,10,0,0"
                                Content="Retry" Command="{Binding Retry}"
                                Visibility="{Binding ShowRetry, Converter={StaticResource Visible}}" />
                        <Button x:Name="OpenSettingsButton" Style="{StaticResource Tray.PrimaryButton}" Margin="0,10,0,0"
                                Content="Open Settings" Command="{Binding OpenMicSettings}"
                                Visibility="{Binding ShowOpenSettings, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Grid>

                <!-- 2. Last dictation (hidden until the first one) -->
                <Border x:Name="LastDictationCard" Margin="0,10,0,0" CornerRadius="20" Padding="14,12"
                        Background="{StaticResource Tray.InnerFlat}"
                        Visibility="{Binding HasLastDictation, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <Grid>
                            <controls:SpacedText Text="LAST DICTATION" FontSize="11" FontWeight="Medium" Tracking="0.55"
                                                 Foreground="{StaticResource Tray.TextValue}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Tray.Link}" HorizontalAlignment="Right"
                                    Content="{Binding CopyLabel}" Command="{Binding Copy}"
                                    AutomationProperties.Name="Copy last dictation" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource Akoya.TextBody}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72.8"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="18.2"
                                   Text="{Binding LastDictation}" />
                    </StackPanel>
                </Border>

                <!-- 3. Options -->
                <Border Margin="0,10,0,0" CornerRadius="18" Padding="0,2" Background="{StaticResource Tray.InnerFlat}">
                    <StackPanel>
                        <Grid>
                            <!-- The yellow "Not detected" highlight (.orow.warnrow): drawn behind the row, so the row
                                 keeps its layout. -->
                            <Border x:Name="MicWarning" CornerRadius="16" BorderThickness="1"
                                    Background="{StaticResource Tray.WarnFill}" BorderBrush="{StaticResource Tray.WarnRim}"
                                    Visibility="{Binding MicMissing, Converter={StaticResource Visible}}" />
                            <Button x:Name="MicRow" Style="{StaticResource Tray.RowButton}" Command="{Binding ToggleMicMenu}"
                                    AutomationProperties.Name="Microphone">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Tray.RowIcon}"
                                          Data="M7,1 A2.5,2.5 0 0 1 9.5,3.5 V6.5 A2.5,2.5 0 0 1 4.5,6.5 V3.5 A2.5,2.5 0 0 1 7,1 Z M2.5,7 A4.5,4.5 0 0 0 11.5,7 M7,11.5 V13" />
                                    <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Microphone" />
                                        <TextBlock x:Name="NotDetected" Margin="0,2,0,0" FontSize="11.5"
                                                   Foreground="{DynamicResource Akoya.Amber}" Text="Not detected"
                                                   Visibility="{Binding MicMissing, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="MicValue" MaxWidth="150" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Tray.TextValue}" Text="{Binding MicLabel}" />
                                        <Path Style="{StaticResource Tray.DropMark}" Margin="4,3,0,0" Fill="{StaticResource Tray.TextValue}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <Rectangle Height="1" Margin="14,0" Fill="{StaticResource Tray.Hairline}" />

                        <Grid Margin="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Tray.RowIcon}"
                                      Data="M7,1.8 V6.8 M4.2,3.6 A4.6,4.6 0 1 0 9.8,3.6" />
                                <TextBlock Margin="9,0,0,0" Text="Launch at startup" VerticalAlignment="Center" />
                            </StackPanel>
                            <controls:NeutralSwitch x:Name="StartupSwitch" HorizontalAlignment="Right"
                                                    IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                                    AutomationProperties.Name="Launch at startup" />
                        </Grid>

                        <StackPanel x:Name="UpdateRow" Visibility="{Binding UpdateReady, Converter={StaticResource Visible}}">
                            <Rectangle Height="1" Margin="14,0" Fill="{StaticResource Tray.Hairline}" />
                            <Grid Margin="14,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Tray.RowIcon}"
                                          Data="M7,1.5 V8.5 M4,5.6 L7,8.6 L10,5.6 M2,12 H12" />
                                    <TextBlock Margin="9,0,0,0" Text="Update ready" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="RestartButton" Style="{StaticResource Tray.PrimaryButton}"
                                        HorizontalAlignment="Right" Padding="14,4" FontSize="12" Content="Restart"
                                        Command="{Binding RestartToUpdate}"
                                        AutomationProperties.Name="Restart to update" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Quit -->
                <Button x:Name="QuitRow" Style="{StaticResource Tray.QuietRow}" Margin="0,10,0,0"
                        HorizontalContentAlignment="Left" Content="Quit Akoya" Command="{Binding Quit}" />
            </StackPanel>
        </controls:RimGlowBorder>

        <!-- Menus, drawn over the panel; TrayPanelView.xaml.cs places them next to their anchors. -->
        <tray:MenuLayer x:Name="MenuLayer">
            <Rectangle x:Name="MenuDismiss" Fill="Transparent"
                       Width="{Binding ActualWidth, ElementName=Root}" Height="{Binding ActualHeight, ElementName=Root}"
                       Visibility="{Binding IsMenuOpen, Converter={StaticResource Visible}}" />

            <controls:RimGlowBorder x:Name="HotkeyMenu" Width="188" CornerRadius="12" Padding="5"
                                    Background="{StaticResource Tray.MenuBackground}"
                                    Shadows="{x:Static ui:RimGlowRecipes.TrayMenu}"
                                    Visibility="{Binding IsHotkeyMenuOpen, Converter={StaticResource Visible}}">
                <StackPanel>
                    <controls:SpacedText Margin="8,4,8,6" Text="HOTKEY" FontSize="11" Tracking="0.44"
                                         Foreground="{StaticResource Tray.TextHintSecondary}" />
                    <ItemsControl ItemsSource="{Binding HotkeyOptions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Tray.MenuRow}" Content="{Binding}"
                                        ContentTemplate="{StaticResource Tray.MenuRowContent}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.SelectHotkey, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:RimGlowBorder>

            <controls:RimGlowBorder x:Name="MicMenu" MinWidth="200" MaxWidth="272" CornerRadius="12" Padding="5"
                                    Background="{StaticResource Tray.MenuBackground}"
                                    Shadows="{x:Static ui:RimGlowRecipes.TrayMenu}"
                                    Visibility="{Binding IsMicMenuOpen, Converter={StaticResource Visible}}">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding MicOptions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Tray.MenuRow}" Content="{Binding}"
                                        ContentTemplate="{StaticResource Tray.MenuRowContent}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.SelectMic, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </controls:RimGlowBorder>
        </tray:MenuLayer>
    </Grid>
</UserControl>
