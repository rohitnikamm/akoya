<!--
  Akoya's neutral switch (docs/superpowers/specs/2026-10-17-all-in-one-dropdown-design.md, "Neutral control styles";
  .sw in docs/design/all-in-one-dropdown-target.html): 34×20. Off: track white 10% with a white 10% hairline, thumb
  white 55%. On: track white 28% with a white 22% hairline, white thumb with a small shadow. The thumb slides 0.28 s.
  A ToggleButton, so bind IsChecked and set AutomationProperties.Name; it needs no resources from its host.
-->
<ToggleButton x:Class="Akoya.App.Controls.NeutralSwitch"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:Akoya.App.Controls"
              xmlns:ui="clr-namespace:Akoya.Core.Ui;assembly=Akoya.Core"
              Width="34"
              Height="20"
              Cursor="Hand"
              VerticalAlignment="Center"
              FocusVisualStyle="{x:Null}">
    <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
                <Border x:Name="Track" CornerRadius="10" Background="#1AFFFFFF" />
                <Border x:Name="Hairline" CornerRadius="10" BorderThickness="1" BorderBrush="#1AFFFFFF" />
                <Border x:Name="FocusRing" CornerRadius="12" Margin="-2" BorderThickness="1.5"
                        BorderBrush="#99FFFFFF" Visibility="Collapsed" />
                <Grid x:Name="Thumb" Width="16" Height="16" Margin="2"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
                    <controls:RimGlowBorder x:Name="ThumbShadow" CornerRadius="8" Opacity="0"
                                            Shadows="{x:Static ui:RimGlowRecipes.SwitchThumb}" />
                    <Ellipse x:Name="ThumbFill" Fill="#8CFFFFFF" />
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="#47FFFFFF" />
                    <Setter TargetName="Hairline" Property="BorderBrush" Value="#38FFFFFF" />
                    <Setter TargetName="ThumbFill" Property="Fill" Value="White" />
                    <Setter TargetName="ThumbShadow" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ToggleButton.Template>
</ToggleButton>
