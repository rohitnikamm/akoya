<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Akoya.App</RootNamespace>
    <!-- Only the win-x64 sherpa-onnx natives ship; the shared framework is still used. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Akoya.Core\Akoya.Core.csproj" />
  </ItemGroup>
</Project>
