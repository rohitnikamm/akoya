<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Akoya.App</RootNamespace>
    <!-- What Task Manager and the file properties show. The assembly keeps its name (pack URIs use it);
         windows/scripts/package.ps1 renames the exe to Akoya.exe for Velopack. -->
    <AssemblyTitle>Akoya</AssemblyTitle>
    <Product>Akoya</Product>
    <!-- Only the win-x64 sherpa-onnx natives ship; the shared framework is still used. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs VelopackApp first and enforces a single instance before WPF starts. -->
    <StartupObject>Akoya.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <InternalsVisibleTo Include="Akoya.App.Tests" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Akoya.Core\Akoya.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Outfit (OFL 1.1, Fonts/OFL.txt), the Mac's variable font; WPF picks its named weight instances. -->
    <Resource Include="Fonts\Outfit-Variable.ttf" />
    <!-- The tray icon (windows/scripts/make-tray-icon.py). -->
    <Resource Include="Assets\akoya.ico" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
