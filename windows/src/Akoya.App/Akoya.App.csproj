<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Akoya.App</RootNamespace>
    <!-- Only the win-x64 sherpa-onnx natives ship; the shared framework is still used. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="SharpCompress" />
    <InternalsVisibleTo Include="Akoya.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Akoya.Core\Akoya.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Outfit (OFL 1.1, Fonts/OFL.txt), the Mac's variable font; WPF picks its named weight instances. -->
    <Resource Include="Fonts\Outfit-Variable.ttf" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
